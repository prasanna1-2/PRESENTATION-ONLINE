{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": "auth != null",

        ".write": "auth != null && (!data.exists() ? newData.child('meta').child('hostUid').val() === auth.uid : data.child('meta').child('hostUid').val() === auth.uid)",

        "meta": {
          ".validate": "newData.hasChildren(['hostUid', 'name', 'fileName', 'fileURL', 'slideCount', 'status'])",
          "hostUid": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "fileName": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "fileType": { ".validate": "newData.isString()" },
          "fileKind": { ".validate": "newData.isString()" },
          "fileURL": { ".validate": "newData.isString()" },
          "slideCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2000" },
          "status": { ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'live' || newData.val() === 'ended')" },
          "createdAt": { ".validate": true },
          "$other": { ".validate": false }
        },

        "state": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['currentSlide'])",
          "currentSlide": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2000" },
          "isPlaying": { ".validate": "newData.isBoolean()" },
          "fullscreen": { ".validate": "newData.isBoolean()" },
          "updatedAt": { ".validate": true },
          "$other": { ".validate": false }
        },

        "controllers": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['joinedAt', 'lastSeen'])",
            "label": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "joinedAt": { ".validate": true },
            "lastSeen": { ".validate": true },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
